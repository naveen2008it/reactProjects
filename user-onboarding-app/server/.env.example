# OnboardMe – Server Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Gmail address used to send OTP and notification emails
GMAIL_USER=your-gmail-address@gmail.com

# Gmail App Password (16 characters, no spaces)
# Generate one at: https://myaccount.google.com/apppasswords
# Enable 2-Step Verification first, then create an App Password for "Mail".
GMAIL_APP_PASS=your_16_char_app_password

# OTP validity window in milliseconds (default: 600000 = 10 minutes)
OTP_EXPIRY_MS=600000

# React development server origin (used for CORS and welcome email link)
CLIENT_ORIGIN=http://localhost:3000

# Port for this Express server (default: 5001)
PORT=5001
